# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env!
NODE_ENV=development
PORT=3000

# Lokasi file SQLite (otomatis dibuat). Pakai :memory: untuk pengujian.
DB_PATH=./data/apajurusanku.sqlite

# Rahasia penanda token login. WAJIB diganti di produksi (min. 32 karakter acak).
JWT_RAHASIA=ganti-dengan-teks-acak-yang-panjang
JWT_MASA_BERLAKU=8h

# Daftar asal (origin) frontend yang diizinkan, pisahkan dengan koma.
CORS_ASAL=http://localhost:3000

# true = backend ikut menyajikan folder frontend (praktis untuk pengembangan).
SAJIKAN_FRONTEND=true

# Admin pertama yang dibuat oleh seeder.
ADMIN_USERNAME=admin
ADMIN_KATA_SANDI=12345678

# true = isi data awal otomatis saat tabel masih kosong (saat server menyala).
ISI_BENIH_OTOMATIS=true
